<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<Title>IVSoftware.Portable.Disposable.AuthorityEpochProvider</Title>
		<PackageId>IVSoftware.Portable.Disposable.AuthorityEpochProvider</PackageId>
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>
		<Description>
			Authority-based coordination over DisposableHost epochs.
			Provides IAuthorityEpochProvider abstractions for deterministic
			ownership, ordered participation, and controlled FinalDispose behavior
			across concurrent consumers.
		</Description>
		<PackageTags>
			idisposable;disposablehost;authority;epoch;reference-counting;
			lifetime-management;concurrency;events;netstandard;portable
		</PackageTags>
		<RepositoryUrl>https://github.com/IVSoftware/IVSoftware.Portable.Disposable.AuthorityEpochProvider.git</RepositoryUrl>
		<PackageProjectUrl>https://github.com/IVSoftware/IVSoftware.Portable.Disposable.AuthorityEpochProvider.git</PackageProjectUrl>

		<RootNamespace>IVSoftware.Portable.Disposable</RootNamespace>
		<TargetFramework>netstandard2.0</TargetFramework>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>

		<Author>Thomas C. Gregor</Author>
		<Owner>IVSoftware LLC</Owner>
		<Copyright>Copyright © 2023-2026 IVSoftware LLC</Copyright>

		<FileVersion>$(AssemblyVersion)</FileVersion>
		<Version>$(AssemblyVersion)</Version>
		<BaseVersion>1.1.0</BaseVersion>
		<VersionPrefix>$(BaseVersion)</VersionPrefix>
		<VersionSuffix>beta</VersionSuffix>

		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
		<PackageIcon>ivs-nuget-logo.4.png</PackageIcon>

		<PackageReleaseNotes>
			1.1.0-beta
			Adds HasEverRequestedAuthority(...) to distinguish epoch participation history
			from currently held authority. This affects only custom IAuthorityEpochProvider
			implementations. The provided concrete implementation supports this
			automatically and serves as a guide to add equivalent epoch-history tracking.

			1.0.3
			Adds TestableEpoch support for deterministic Guid and DateTimeOffset
			generation in unit tests, along with documentation and broader MSTest
			coverage for repeatable fixture generation.

			1.0.2
			Improves usability by adding the default
			CancelAuthorityEpoch(@throw = false) behavior and promoting generic
			Authority and Authorities members for easier direct consumption.

			1.0.1
			Strengthens the generic API with runtime type enforcement and expanded
			test coverage for cancellation, mixed-authority scenarios, lifecycle
			invariants, awaitable completion, and context snapshot behavior.

			1.0.0
			Initial release of AuthorityEpochProvider for authority-based coordination
			over DisposableHost epochs, including first-wins authority selection,
			reference-counted participation, and deterministic FinalDispose behavior.
		</PackageReleaseNotes>

		<AssemblyOriginatorKeyFile>D:\PFX\231201.ivs.pfx</AssemblyOriginatorKeyFile>
		<DebugType>embedded</DebugType>
		<SignAssembly>True</SignAssembly>
	</PropertyGroup>

	<ItemGroup>
		<Compile Remove="README\**" />
		<EmbeddedResource Remove="README\**" />
		<None Remove="README\**" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

	<ItemGroup>
		<None Include="..\IVSoftware.Portable.Disposable.AuthorityEpochProvider\img\ivs-nuget-logo.4.png">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="IVSoftware.Portable.Common" Version="*" />
		<PackageReference Include="IVSoftware.Portable.Disposable" Version="*" />
		<PackageReference Include="IVSoftware.Portable.Xml.Linq.XBoundObject" Version="*" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
	</ItemGroup>

</Project>
